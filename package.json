{
  "name": "design-system-sansys-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "dev": "npm run dev --workspace=@sansys/docs-portal",
    "build": "npm run build --workspace=@sansys/docs-portal",
    "core:build": "npm run build:lib --workspace=@sansys/design-system",
    "core:dev": "npm run dev --workspace=@sansys/design-system",
    "docs:dev": "npm run dev --workspace=@sansys/docs-portal",
    "docs:build": "npm run build --workspace=@sansys/docs-portal",
    "sandbox:dev": "npm run dev --workspace=@sansys/sandbox",
    "mcp:build": "npm run build --workspace=@sansys/dss-mcp",
    "mcp:start": "npm run start --workspace=@sansys/dss-mcp",
    "build:all": "npm run core:build && npm run docs:build && npm run mcp:build",
    "portal:sync-docs": "node scripts/generate-portal-landing-pages.cjs",
    "sync:visual-contract": "node scripts/sync-visual-contract.js",
    "sync:portal-tokens": "node scripts/sync-portal-tokens.mjs",
    "sync:css-to-meta": "node scripts/sync-css-to-meta.js --fix-sources",
    "sync:token-values": "node scripts/sync-token-values.js --fix",
    "sync:tokens-to-reference": "node scripts/sync-tokens-to-reference.js",
    "validate:type-check": "npm run type-check --workspace=@sansys/design-system",
    "validate:css-meta": "node scripts/sync-css-to-meta.js --validate",
    "validate:token-values": "node scripts/sync-token-values.js --audit",
    "validate:api-docs": "node scripts/validate-api-docs.cjs",
    "validate:api-docs:gate": "node scripts/validate-api-docs.cjs --gate",
    "catalog:build": "node scripts/build-catalog.cjs",
    "catalog:validate": "node scripts/build-catalog.cjs --validate",
    "contracts:emit": "node scripts/emit-contract.mjs --all --write",
    "contracts:gate": "node scripts/emit-contract.mjs --all --strict",
    "spec:check": "node scripts/emit-spec.mjs",
    "spec:gate": "node scripts/emit-spec.mjs --gate",
    "spec:parecer": "node scripts/spec-parecer.mjs",
    "validate:sandbox-tags": "node scripts/validate-sandbox-tags.cjs --gate",
    "validate:portal-pages": "node scripts/validate-portal-pages.cjs --gate",
    "validate:demo-registry": "node scripts/validate-demo-registry.cjs --gate",
    "validate:barrel-ext": "node scripts/validate-barrel-ext.cjs --gate",
    "probe:visual": "node scripts/probe-visual-contract.mjs",
    "validate:structure": "node scripts/validate-structure.cjs",
    "validate:structure:gate": "node scripts/validate-structure.cjs --gate",
    "validate:sfc-hygiene": "node scripts/validate-sfc-hygiene.cjs",
    "validate:sfc-hygiene:gate": "node scripts/validate-sfc-hygiene.cjs --gate",
    "validate:variant-naming": "node scripts/validate-variant-naming.cjs",
    "validate:variant-naming:gate": "node scripts/validate-variant-naming.cjs --gate",
    "validate:scss-tokens": "node scripts/validate-scss-tokens.cjs",
    "validate:scss-tokens:gate": "node scripts/validate-scss-tokens.cjs --gate",
    "validate:field-conventions": "node scripts/validate-field-conventions.cjs",
    "validate:field-conventions:gate": "node scripts/validate-field-conventions.cjs --gate",
    "sync:all": "node scripts/sync-tokens-to-reference.js && node scripts/sync-css-to-meta.js --fix-sources && node scripts/sync-token-values.js --fix && node scripts/sync-visual-contract.js",
    "inject:token-markers": "node scripts/inject-token-table-markers.js",
    "update:meta-preview": "node scripts/update-meta-preview.cjs",
    "setup:hooks": "cp scripts/hooks/pre-commit scripts/hooks/post-merge .git/hooks/ && chmod +x .git/hooks/pre-commit .git/hooks/post-merge && echo 'Git hooks instalados (pre-commit, post-merge).'",
    "validate:theme-scopes": "node scripts/validate-theme-scopes.mjs"
  },
  "type": "module",
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "dependencies": {
    "@swc/core-linux-x64-gnu": "^1.15.8"
  }
}
