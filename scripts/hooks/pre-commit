#!/bin/sh
# DSS pre-commit hook
# Cadeia de automação: CSS → meta.json → DSS_REFERENCIA → TOKEN_REFERENCE

STAGED=$(git diff --cached --name-only)

# ── 0. Barrel export = index.ts (sem index.js novo em packages/core) ─────────
if echo "$STAGED" | grep -qE 'packages/core/.+/index\.js$|packages/core/index\.js$'; then
  echo "🔍 Validando extensão de barrel (index.ts canônico)..."
  node scripts/validate-barrel-ext.cjs --gate
  if [ $? -ne 0 ]; then
    echo "❌ index.js reintroduzido — o barrel de componente deve ser index.ts."
    exit 1
  fi
fi

# ── 1. Token SCSS alterado → regenera DSS_TOKEN_REFERENCE.md ─────────────────
if echo "$STAGED" | grep -q 'packages/core/tokens/semantic/'; then
  echo "🔄 Token SCSS alterado — sincronizando DSS_TOKEN_REFERENCE.md..."
  node scripts/sync-tokens-to-reference.js
  if [ $? -ne 0 ]; then
    echo "❌ Falha ao sincronizar DSS_TOKEN_REFERENCE.md. Commit abortado."
    exit 1
  fi
  git add docs/reference/DSS_TOKEN_REFERENCE.md
  echo "✅ DSS_TOKEN_REFERENCE.md atualizado e staged."
fi

# ── 1b. Qualquer token alterado → propaga p/ o docs-portal (anti-drift A12) ──
# O portal mantinha 355 --dss-* à mão (262 dup, 13 divergentes). sync:portal-tokens
# regenera o bloco auto a partir de packages/core/tokens/index.scss.
if echo "$STAGED" | grep -q 'packages/core/tokens/'; then
  echo "🔄 Token alterado — propagando tokens p/ o docs-portal..."
  node scripts/sync-portal-tokens.mjs
  if [ $? -ne 0 ]; then
    echo "❌ Falha ao sincronizar tokens do portal. Commit abortado."
    exit 1
  fi
  git add apps/docs-portal/src/index.css
  echo "✅ Tokens do portal sincronizados e staged."
fi

# ── 2. SCSS de componente alterado → valida CSS ↔ meta.json ──────────────────
# NOTA (2026-07): --validate (default) checa apenas que os tokens em
# visualProperties são tokens DSS VÁLIDOS (catálogo), NÃO que o componente os usa
# de fato — logo NÃO bloqueia troca de token no CSS. A verdade visual auto-derivada
# vive no dss.contract.json (visual.states, §8). meta.visualProperties é a camada
# CURADA de defaultPreview; sua staleness é débito conhecido (ver DEBITO_ABERTO).
if echo "$STAGED" | grep -qE 'packages/core/components/base/.+\.scss'; then
  echo "🔍 SCSS de componente alterado — validando tokens do meta.json (catálogo)..."
  node scripts/sync-css-to-meta.js --validate
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Token inválido (fora do catálogo DSS) em 'visualProperties'."
    echo "   Corrija o dss.meta.json para usar apenas tokens --dss-* existentes."
    exit 1
  fi
  echo "✅ tokens do meta.json: válidos (catálogo)."
fi

# ── 3. meta.json alterado → sincroniza DSS_REFERENCIA_VISUAL_ANALISE.md ──────
if echo "$STAGED" | grep -q 'dss\.meta\.json'; then
  echo "🔄 dss.meta.json alterado — sincronizando DSS_REFERENCIA_VISUAL_ANALISE.md..."
  node scripts/sync-visual-contract.js
  if [ $? -ne 0 ]; then
    echo "❌ Falha ao sincronizar o contrato visual. Commit abortado."
    exit 1
  fi
  git add docs/governance/DSS_REFERENCIA_VISUAL_ANALISE.md
  echo "✅ DSS_REFERENCIA_VISUAL_ANALISE.md atualizado e staged."
fi

# ── 3b. meta.json ou selo alterado → regenera catalog.json + GATE de drift ──
# catalog.json é a fonte única consumível por MCP/portal/DemoRenderer (deriva
# "selado" do arquivo físico, não do status, que driftou). Os 11 drifts status↔selo
# pré-existentes foram reconciliados (jun/2026) → gate duro LIGADO: bloqueia commit
# se status contradiz selo físico ou se CERTIFIED↔selo divergir.
if echo "$STAGED" | grep -qE 'dss\.meta\.json|docs/Compliance/seals/'; then
  echo "🔄 meta/selo alterado — regenerando catalog.json..."
  node scripts/build-catalog.cjs
  if [ $? -ne 0 ]; then
    echo "❌ Falha ao gerar catalog.json. Commit abortado."
    exit 1
  fi
  git add packages/core/catalog.json
  echo "🔒 Validando consistência status↔selo↔CERTIFIED..."
  node scripts/build-catalog.cjs --validate
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Contradição de catálogo: status contradiz selo físico (ou CERTIFIED↔selo)."
    echo "   'Selado' = arquivo em docs/Compliance/seals/<Comp>/. Alinhe o 'status' no"
    echo "   dss.meta.json (sealed/conformant/approved) OU remova o selo se prematuro."
    exit 1
  fi
  echo "✅ catalog.json regenerado, staged e consistente."
fi

# ── 3c. selo/catálogo/páginas alterados → todo selado tem página no portal ───
# Gate duro só na direção "selado sem página" (página órfã é só aviso).
if echo "$STAGED" | grep -qE 'dss\.meta\.json|docs/Compliance/seals/|packages/core/catalog\.json|apps/docs-portal/src/pages/components/'; then
  echo "🔍 Validando cobertura de páginas do portal (selado → página)..."
  node scripts/validate-portal-pages.cjs --gate
  if [ $? -ne 0 ]; then
    echo "❌ Componente selado sem página no portal. Gere: npm run portal:sync-docs"
    exit 1
  fi
fi

# ── 5. API (slots/props/events/arrays-sandbox) ↔ types: valida componentes staged ──
# Dispara quando types/*.types.ts, *_API.md, README.md OU a Test page do sandbox
# mudam (a Test page carrega arrays VARIANTS/SIZES/BRAND_KEYS/SLOTS que espelham os
# types — drift silencioso). Escopado aos componentes alterados.
API_COMPS=$(echo "$STAGED" | sed -nE 's#^packages/core/components/[^/]+/(Dss[A-Za-z0-9]+)/(types/.+\.types\.ts|[A-Z0-9_]+_API\.md|README\.md)$#\1#p' | sort -u)
SANDBOX_COMPS=$(echo "$STAGED" | sed -nE 's#^apps/sandbox/src/Test([A-Za-z0-9]+)\.vue$#Dss\1#p' | sort -u)
API_COMPS=$(printf '%s\n%s\n' "$API_COMPS" "$SANDBOX_COMPS" | sort -u | sed '/^[[:space:]]*$/d')
if [ -n "$API_COMPS" ]; then
  echo "🔍 Validando paridade de API (types → docs) dos componentes alterados..."
  node scripts/validate-api-docs.cjs --gate $API_COMPS
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ API divergente da fonte de verdade (types/*.types.ts)."
    echo "   Detalhe:  node scripts/validate-api-docs.cjs <Componente>"
    echo "   Corrigir: node scripts/validate-api-docs.cjs --fix <Componente>  (adiciona ao *_API.md o que falta)"
    echo "   Extras não-tipados exigem decisão: completar a interface OU remover da doc."
    exit 1
  fi
  echo "✅ Paridade de API: OK."
fi

# ── 6. Sandbox: tag <Dss*> usada sem import (regressão Avatar/Badge) ─────────
# O sandbox registra globalmente só Quasar; cada DSS precisa de import local.
# Tag não-resolvida vira custom-element desconhecido → 0 elementos reais (silencioso).
SANDBOX_VUE=$(echo "$STAGED" | grep -E '^apps/sandbox/src/.+\.vue$')
if [ -n "$SANDBOX_VUE" ]; then
  echo "🔍 Validando tags DSS no sandbox (import obrigatório)..."
  node scripts/validate-sandbox-tags.cjs --gate $SANDBOX_VUE
  if [ $? -ne 0 ]; then
    echo "❌ Tag <Dss*> usada sem import — sandbox não reflete a fonte de verdade."
    exit 1
  fi
  echo "✅ Tags DSS do sandbox: OK."
fi

# ── 6b. DemoRenderer registry ↔ componentes base (drift de registry) ─────────
# Componente base novo/selado esquecido no registry manual não aparece no sandbox.
if echo "$STAGED" | grep -qE 'apps/sandbox/src/DemoRenderer\.vue|packages/core/catalog\.json|dss\.meta\.json'; then
  echo "🔍 Validando registry do DemoRenderer (todo base presente)..."
  node scripts/validate-demo-registry.cjs --gate
  if [ $? -ne 0 ]; then
    echo "❌ Componente base ausente do registry do DemoRenderer."
    exit 1
  fi
fi

# ── 8. Contrato derivado (emit-contract) — GATE incremental ──────────────────
# Só enforça componentes que JÁ têm dss.contract.json (rollout: entram no gate à
# medida que o backfill de classification/tagline/a11y avança). Re-emite + valida
# (--strict: bloqueia contrato inválido OU âncora a11y reprovada) + re-stage.
# Schema/emissor/extratores alterados → re-emite TODOS os contratos.
if echo "$STAGED" | grep -qE 'scripts/(emit-contract|extract-css-states|wcag-kit)\.mjs|docs/governance/dss\.contract\.schema\.json'; then
  echo "🔄 Schema/emissor de contrato alterado — re-emitindo TODOS os contratos..."
  node scripts/emit-contract.mjs --all --write --strict
  if [ $? -ne 0 ]; then
    echo "❌ Gate de contrato: contrato inválido ou âncora a11y reprovada."
    exit 1
  fi
  git add packages/core/components/*/*/dss.contract.json 2>/dev/null
  echo "✅ Contratos regenerados, validados e staged."
else
  CONTRACT_COMPS=$(echo "$STAGED" | sed -nE 's#^packages/core/components/[^/]+/(Dss[A-Za-z0-9]+)/(types/.+\.types\.ts|.+\.scss|dss\.meta\.json)$#\1#p' | sort -u)
  GATED=""
  for c in $CONTRACT_COMPS; do
    d=$(find packages/core/components -type d -name "$c" 2>/dev/null | head -1)
    [ -n "$d" ] && [ -f "$d/dss.contract.json" ] && GATED="$GATED $c"
  done
  GATED=$(echo "$GATED" | xargs)
  if [ -n "$GATED" ]; then
    echo "🔄 Fonte de contrato alterada — re-emitindo: $GATED"
    node scripts/emit-contract.mjs $GATED --write --strict
    if [ $? -ne 0 ]; then
      echo "❌ Gate de contrato: contrato inválido ou âncora a11y reprovada."
      exit 1
    fi
    for c in $GATED; do
      d=$(find packages/core/components -type d -name "$c" 2>/dev/null | head -1)
      [ -n "$d" ] && git add "$d/dss.contract.json"
    done
    echo "✅ Contrato(s) regenerado(s), validado(s) e staged."
  fi
fi

# ── 4. Regressão visual Quasar↔DSS (testes estáticos) ────────────────────────
if echo "$STAGED" | grep -qE 'apps/sandbox/public/|packages/core/themes/'; then
  echo "🎨 Validando isolamento Quasar↔DSS (regressão estática)..."
  (cd apps/sandbox && npm run test:static) || {
    echo "❌ Regressão visual detectada. Verifique apps/sandbox/tests/regression/static/"
    exit 1
  }
  echo "✅ Isolamento Quasar↔DSS: OK."
fi

# ── 7. Type-check (vue-tsc) — GATE bloqueante desde jun/2026 ─────────────────
# A baseline de 66 erros pré-existentes foi zerada (vue-tsc --noEmit = 0).
# Dispara quando qualquer .ts/.vue de packages/core é alterado. vue-tsc é
# project-wide (não escopa por arquivo), então roda o type-check completo do core.
# Impede regressão de tipo. Detalhe em docs/governance/HANDOFF_TYPECHECK_BACKLOG.md.
if echo "$STAGED" | grep -qE '^packages/core/.+\.(ts|vue)$'; then
  echo "🔎 .ts/.vue do core alterado — rodando type-check (vue-tsc)..."
  (cd packages/core && npm run type-check) || {
    echo ""
    echo "❌ Erros de type-check (vue-tsc). Corrija antes de commitar."
    echo "   Detalhe: cd packages/core && npm run type-check"
    exit 1
  }
  echo "✅ Type-check: 0 erros."
fi

exit 0
