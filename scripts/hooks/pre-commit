#!/bin/sh
# DSS pre-commit hook
# Cadeia de automação: CSS → meta.json → DSS_REFERENCIA → TOKEN_REFERENCE

STAGED=$(git diff --cached --name-only)

# ── 1. Token SCSS alterado → regenera DSS_TOKEN_REFERENCE.md ─────────────────
if echo "$STAGED" | grep -q 'packages/core/tokens/semantic/'; then
  echo "🔄 Token SCSS alterado — sincronizando DSS_TOKEN_REFERENCE.md..."
  node scripts/sync-tokens-to-reference.js
  if [ $? -ne 0 ]; then
    echo "❌ Falha ao sincronizar DSS_TOKEN_REFERENCE.md. Commit abortado."
    exit 1
  fi
  git add docs/reference/DSS_TOKEN_REFERENCE.md
  echo "✅ DSS_TOKEN_REFERENCE.md atualizado e staged."
fi

# ── 1b. Qualquer token alterado → propaga p/ o docs-portal (anti-drift A12) ──
# O portal mantinha 355 --dss-* à mão (262 dup, 13 divergentes). sync:portal-tokens
# regenera o bloco auto a partir de packages/core/tokens/index.scss.
if echo "$STAGED" | grep -q 'packages/core/tokens/'; then
  echo "🔄 Token alterado — propagando tokens p/ o docs-portal..."
  node scripts/sync-portal-tokens.mjs
  if [ $? -ne 0 ]; then
    echo "❌ Falha ao sincronizar tokens do portal. Commit abortado."
    exit 1
  fi
  git add apps/docs-portal/src/index.css
  echo "✅ Tokens do portal sincronizados e staged."
fi

# ── 2. SCSS de componente alterado → valida CSS ↔ meta.json ──────────────────
if echo "$STAGED" | grep -qE 'packages/core/components/base/.+\.scss'; then
  echo "🔍 SCSS de componente alterado — validando CSS → meta.json..."
  node scripts/sync-css-to-meta.js --validate
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Divergência CSS ↔ meta.json detectada."
    echo "   Atualize o campo 'visualProperties' no dss.meta.json do componente"
    echo "   para refletir os tokens reais usados no CSS e tente novamente."
    exit 1
  fi
  echo "✅ CSS → meta.json: validação ok."
fi

# ── 3. meta.json alterado → sincroniza DSS_REFERENCIA_VISUAL_ANALISE.md ──────
if echo "$STAGED" | grep -q 'dss\.meta\.json'; then
  echo "🔄 dss.meta.json alterado — sincronizando DSS_REFERENCIA_VISUAL_ANALISE.md..."
  node scripts/sync-visual-contract.js
  if [ $? -ne 0 ]; then
    echo "❌ Falha ao sincronizar o contrato visual. Commit abortado."
    exit 1
  fi
  git add docs/governance/DSS_REFERENCIA_VISUAL_ANALISE.md
  echo "✅ DSS_REFERENCIA_VISUAL_ANALISE.md atualizado e staged."
fi

# ── 5. API (slots/props/events/arrays-sandbox) ↔ types: valida componentes staged ──
# Dispara quando types/*.types.ts, *_API.md, README.md OU a Test page do sandbox
# mudam (a Test page carrega arrays VARIANTS/SIZES/BRAND_KEYS/SLOTS que espelham os
# types — drift silencioso). Escopado aos componentes alterados.
API_COMPS=$(echo "$STAGED" | sed -nE 's#^packages/core/components/[^/]+/(Dss[A-Za-z0-9]+)/(types/.+\.types\.ts|[A-Z0-9_]+_API\.md|README\.md)$#\1#p' | sort -u)
SANDBOX_COMPS=$(echo "$STAGED" | sed -nE 's#^apps/sandbox/src/Test([A-Za-z0-9]+)\.vue$#Dss\1#p' | sort -u)
API_COMPS=$(printf '%s\n%s\n' "$API_COMPS" "$SANDBOX_COMPS" | sort -u | sed '/^[[:space:]]*$/d')
if [ -n "$API_COMPS" ]; then
  echo "🔍 Validando paridade de API (types → docs) dos componentes alterados..."
  node scripts/validate-api-docs.cjs --gate $API_COMPS
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ API divergente da fonte de verdade (types/*.types.ts)."
    echo "   Detalhe:  node scripts/validate-api-docs.cjs <Componente>"
    echo "   Corrigir: node scripts/validate-api-docs.cjs --fix <Componente>  (adiciona ao *_API.md o que falta)"
    echo "   Extras não-tipados exigem decisão: completar a interface OU remover da doc."
    exit 1
  fi
  echo "✅ Paridade de API: OK."
fi

# ── 4. Regressão visual Quasar↔DSS (testes estáticos) ────────────────────────
if echo "$STAGED" | grep -qE 'apps/sandbox/public/|packages/core/themes/'; then
  echo "🎨 Validando isolamento Quasar↔DSS (regressão estática)..."
  (cd apps/sandbox && npm run test:static) || {
    echo "❌ Regressão visual detectada. Verifique apps/sandbox/tests/regression/static/"
    exit 1
  }
  echo "✅ Isolamento Quasar↔DSS: OK."
fi

exit 0
