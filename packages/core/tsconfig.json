{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "types": ["vite/client"]
  },
  "include": [
    "env.d.ts",
    "components/**/*.ts",
    "components/**/*.vue",
    "composables/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.js",
    "**/*.example.vue",
    "components/**/index.js"
  ]
}
