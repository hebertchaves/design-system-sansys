{
  "schemaId": "dss-component-contract@1",
  "name": "DssUploader",
  "version": "2.2",
  "identity": {
    "displayName": "Uploader",
    "tagline": "Área de upload que orquestra seleção, fila, progresso e envio de arquivos com identidade visual DSS.",
    "category": "Upload",
    "classification": "Visual",
    "phase": 2,
    "status": "sealed",
    "goldenReference": "DssBadge",
    "goldenContext": "DssCard"
  },
  "audit": {
    "status": "sealed",
    "date": "1970-01-01",
    "sealPath": "docs/Compliance/seals/DssUploader/DSSUPLOADER_SELO_v2.2.md"
  },
  "api": {
    "props": [
      {
        "name": "url",
        "type": "string",
        "controlHint": "text",
        "description": "URL para envio dos arquivos"
      },
      {
        "name": "method",
        "type": "UploaderMethod",
        "controlHint": "segmented",
        "description": "Método HTTP. Padrão: 'POST'.",
        "validValues": [
          "POST",
          "PUT"
        ]
      },
      {
        "name": "headers",
        "type": "Record<string, string> | Array<{ name: string; value: string }>",
        "controlHint": "text",
        "description": "Cabeçalhos HTTP adicionais"
      },
      {
        "name": "formFields",
        "type": "Array<{ name: string; value: string }>",
        "controlHint": "text",
        "description": "Campos de formulário adicionais"
      },
      {
        "name": "withCredentials",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Envia credenciais (cookies, auth headers)"
      },
      {
        "name": "sendRaw",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Envia arquivo como binário puro (sem FormData)"
      },
      {
        "name": "factory",
        "type": "UploaderFactory",
        "controlHint": "text",
        "description": "Configuração dinâmica de upload via função"
      },
      {
        "name": "multiple",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Permite selecionar múltiplos arquivos. Padrão: false."
      },
      {
        "name": "accept",
        "type": "string",
        "controlHint": "text",
        "description": "Filtro de tipos aceitos (ex: \".pdf,image/*\")"
      },
      {
        "name": "maxFiles",
        "type": "number",
        "controlHint": "stepper",
        "description": "Número máximo de arquivos na fila"
      },
      {
        "name": "maxFileSize",
        "type": "number",
        "controlHint": "stepper",
        "description": "Tamanho máximo por arquivo em bytes"
      },
      {
        "name": "maxTotalSize",
        "type": "number",
        "controlHint": "stepper",
        "description": "Tamanho máximo total da fila em bytes"
      },
      {
        "name": "autoUpload",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Inicia o upload automaticamente ao adicionar arquivos. Padrão: false."
      },
      {
        "name": "batch",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Envia todos os arquivos em um único request. Padrão: false."
      },
      {
        "name": "disable",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Desabilita toda interação com o componente. Padrão: false."
      },
      {
        "name": "readonly",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Modo somente leitura — mostra arquivos mas impede adição/remoção. Padrão: false."
      },
      {
        "name": "variant",
        "type": "UploaderVariant",
        "controlHint": "segmented",
        "description": "Variante visual do container. Padrão: 'elevated'.",
        "validValues": [
          "elevated",
          "outline",
          "subtle"
        ]
      },
      {
        "name": "brand",
        "type": "UploaderBrand",
        "controlHint": "picker-brand",
        "description": "Contexto de brand Sansys",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "label",
        "type": "string",
        "controlHint": "text",
        "description": "Texto da dropzone vazia"
      },
      {
        "name": "addAriaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "aria-label do botão \"Adicionar arquivos\""
      },
      {
        "name": "uploadAriaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "aria-label do botão \"Fazer upload\""
      },
      {
        "name": "abortAriaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "aria-label do botão \"Cancelar upload\""
      },
      {
        "name": "clearAriaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "aria-label do botão \"Limpar fila\""
      }
    ],
    "emits": [
      {
        "name": "added",
        "payload": "readonly File[]",
        "description": "Arquivos foram adicionados à fila"
      },
      {
        "name": "removed",
        "payload": "readonly File[]",
        "description": "Arquivos foram removidos da fila"
      },
      {
        "name": "rejected",
        "payload": "ReadonlyArray<{ failedPropValidation: string; file: File }>",
        "description": "Arquivos foram rejeitados por validação"
      },
      {
        "name": "uploading",
        "payload": "{ files: readonly File[]; xhr: XMLHttpRequest }",
        "description": "Upload iniciado"
      },
      {
        "name": "uploaded",
        "payload": "{ files: readonly File[]; xhr: XMLHttpRequest }",
        "description": "Upload concluído com sucesso"
      },
      {
        "name": "failed",
        "payload": "{ files: readonly File[]; xhr: XMLHttpRequest }",
        "description": "Upload falhou"
      }
    ],
    "slots": [],
    "exposedRefs": [
      {
        "name": "upload",
        "type": "() => void",
        "description": "Inicia o upload manualmente"
      },
      {
        "name": "abort",
        "type": "() => void",
        "description": "Aborta o upload em andamento"
      },
      {
        "name": "reset",
        "type": "() => void",
        "description": "Limpa a fila de arquivos"
      },
      {
        "name": "pickFiles",
        "type": "() => void",
        "description": "Abre o seletor de arquivos"
      }
    ]
  },
