  "a11y": {
    "wcag": [
      {
        "criterion": "1.3.1",
        "level": "A",
        "implementation": "Compõe a semântica tabular do DssTable e preserva cabeçalhos e células.",
        "verifiedBy": "test",
        "verified": true,
        "test": [
          "compõe DssTable dentro de um DssCard",
          "renderiza cabeçalho e células"
        ]
      },
      {
        "criterion": "1.4.1",
        "level": "A",
        "implementation": "A situação é chip com rótulo e ícone — cor nunca é o único veículo; valor não declarado cai em neutro sem ícone.",
        "verifiedBy": "test",
        "verified": true,
        "test": [
          "pinta a situação como chip com rótulo e ícone",
          "cai em neutro e sem ícone para situação não declarada"
        ]
      },
      {
        "criterion": "4.1.2",
        "level": "A",
        "implementation": "A raiz comunica busy e disabled, e os controles recebem nome contextual com o identificador da linha.",
        "verifiedBy": "test",
        "verified": true,
        "test": [
          "comunica loading e disabled na raiz",
          "nomeia os controles pelo contexto"
        ]
      },
      {
        "criterion": "4.1.3",
        "level": "AA",
        "implementation": "A contagem de registros é região viva aria-live=polite, porque filtrar não move o foco.",
        "verifiedBy": "test",
        "verified": true,
        "test": "anuncia a contagem de registros em região viva"
      }
    ],
