  "a11y": {
    "wcag": [
      {
        "criterion": "2.1.1",
        "level": "A",
        "implementation": "Navegação e seleção por teclado herdadas do QSelect (base DssSelect): setas, Enter/Espaço, Escape.",
        "verifiedBy": "test"
      },
      {
        "criterion": "4.1.2",
        "level": "A",
        "implementation": "role=combobox + aria-multiselectable; estado de cada opção via aria-selected (fonte de verdade — o checkbox por opção é decorativo/aria-hidden).",
        "verifiedBy": "aria"
      }
    ],
    "aria": {
      "role": "combobox",
      "states": [
        "aria-expanded",
        "aria-multiselectable",
        "aria-selected",
        "aria-disabled",
        "aria-label"
      ]
    },
    "keyboard": [
      {
        "key": "ArrowDown / ArrowUp",
        "action": "navegar entre as opções"
      },
      {
        "key": "Enter / Space",
        "action": "alternar a seleção da opção em foco"
      },
      {
        "key": "Escape",
        "action": "fechar o dropdown"
      },
      {
        "key": "Backspace",
        "action": "remover o último token quando o campo de busca está vazio"
      }
    ]
  },
