  },
  "api": {
    "props": [
      {
        "name": "rows",
        "type": "Record<string, unknown>[]",
        "controlHint": "text",
        "required": true,
        "description": "Linhas de dados da tabela (obrigatório)",
        "category": "Comportamento",
        "categorySource": "quasar"
      },
      {
        "name": "columns",
        "type": "DssTableColumn[]",
        "controlHint": "text",
        "required": true,
        "description": "Definição das colunas (obrigatório)",
        "category": "Conteúdo",
        "categorySource": "quasar"
      },
      {
        "name": "rowKey",
        "type": "string",
        "controlHint": "text",
        "description": "Chave única de cada linha",
        "category": "Comportamento",
        "categorySource": "quasar"
      },
      {
        "name": "title",
        "type": "string",
        "controlHint": "text",
        "description": "Título exibido na área top da tabela",
        "category": "Conteúdo",
        "categorySource": "override"
      },
      {
        "name": "loading",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Estado de carregamento — exibe DssSpinner interno do QTable",
        "category": "Estado",
        "categorySource": "override"
      },
      {
        "name": "filter",
        "type": "string",
        "controlHint": "text",
        "description": "Texto de filtro global (case-insensitive)",
        "category": "Estado",
        "categorySource": "quasar"
      },
      {
        "name": "selection",
        "type": "DssTableSelection",
        "controlHint": "segmented",
        "description": "Tipo de seleção de linhas",
        "validValues": [
          "single",
          "multiple",
          "none"
        ],
        "category": "Estado",
        "categorySource": "quasar"
      },
      {
        "name": "modelValue",
        "type": "Record<string, unknown>[]",
        "controlHint": "text",
        "description": "Linhas selecionadas (v-model)",
        "category": "Conteúdo",
        "categorySource": "vmodel"
      },
      {
        "name": "pagination",
        "type": "DssTablePagination",
        "controlHint": "text",
        "description": "Estado de paginação (v-model:pagination)",
        "category": "Comportamento",
        "categorySource": "quasar"
      },
      {
        "name": "density",
        "type": "DssTableDensity",
        "controlHint": "segmented",
        "description": "Densidade da tabela — compact: menor espaçamento, comfortable: maior",
        "validValues": [
          "compact",
          "standard",
          "comfortable"
        ],
        "category": "Aparência",
        "categorySource": "excecao"
      },
      {
        "name": "bordered",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Borda ao redor da tabela",
        "category": "Aparência",
        "categorySource": "quasar"
      },
      {
        "name": "flat",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Remove a elevação (flat = sem sombra)",
        "category": "Aparência",
        "categorySource": "quasar"
      },
      {
        "name": "wrapCells",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Permite quebra de linha nas células",
        "category": "Conteúdo",
        "categorySource": "quasar"
      },
      {
        "name": "separator",
        "type": "DssTableSeparator",
        "controlHint": "segmented",
        "description": "Tipo de separador entre células",
        "validValues": [
          "horizontal",
          "vertical",
          "cell",
          "none"
        ],
        "category": "Conteúdo",
        "categorySource": "quasar"
      },
      {
        "name": "virtualScroll",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Ativa virtualização de linhas para grandes conjuntos de dados",
        "category": "Comportamento",
        "categorySource": "quasar"
      },
      {
        "name": "noDataLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Texto exibido quando rows está vazio",
        "category": "Conteúdo",
        "categorySource": "quasar"
      },
      {
        "name": "noResultsLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Texto exibido quando filter não encontra resultados",
        "category": "Conteúdo",
        "categorySource": "quasar"
      },
      {
        "name": "hideBottom",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Oculta a área bottom (paginação + itens por página)",
        "category": "Conteúdo",
        "categorySource": "quasar"
      },
      {
        "name": "hideHeader",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Oculta o cabeçalho da tabela",
        "category": "Conteúdo",
        "categorySource": "quasar"
      },
      {
        "name": "rowsPerPageOptions",
        "type": "number[]",
        "controlHint": "text",
        "description": "Opções de linhas por página na paginação",
        "category": "Comportamento",
        "categorySource": "quasar"
      }
    ],
    "emits": [
      {
        "name": "update:modelValue",
        "payload": "Record<string, unknown>[]",
        "description": "Sincronização de linhas selecionadas (v-model)"
      },
      {
        "name": "update:pagination",
        "payload": "DssTablePagination",
        "description": "Sincronização do estado de paginação"
      },
      {
        "name": "request",
        "payload": "{\r\n      pagination: DssTablePagination\r\n      filter?: string\r\n      getCellValue: (col: DssTableColumn, row: Record<string, unknown>) => unknown\r\n    }",
        "description": "Evento de requisição server-side (quando @request é necessário)"
      },
      {
        "name": "selection",
        "payload": "{\r\n      rows: Record<string, unknown>[]\r\n      keys: unknown[]\r\n      added: boolean\r\n      evt: Event\r\n    }",
        "description": "Evento de mudança de seleção"
      },
      {
        "name": "row-click",
        "payload": "Event",
        "description": "Clique em linha"
      },
      {
        "name": "row-dblclick",
        "payload": "Event",
        "description": "Duplo-clique em linha"
      },
      {
        "name": "row-contextmenu",
        "payload": "Event",
        "description": "Clique-direito em linha"
      }
    ],
    "slots": [
      {
        "name": "top",
        "scope": null,
        "description": "Área top completa (quando usado, substitui top-left e top-right)"
      },
      {
        "name": "top-left",
        "scope": null,
        "description": "Lado esquerdo da área top (título, ações em massa)"
      },
      {
        "name": "top-right",
        "scope": null,
        "description": "Lado direito da área top (campo de filtro, configurações)"
      },
      {
        "name": "top-row",
        "scope": null,
        "description": "Linha adicional na área top"
      },
      {
        "name": "top-selection",
        "scope": "selected",
        "description": "Ações exibidas quando linhas estão selecionadas"
      },
      {
        "name": "header",
        "scope": "cols, colsMap",
        "description": "Cabeçalho completo (substitui renderização padrão do thead)"
      },
      {
        "name": "header-cell",
        "scope": "col, colIndex",
        "description": "Célula de cabeçalho individual"
      },
      {
        "name": "body",
        "scope": "key, row, rowIndex, cols, selected, pageIndex",
        "description": "Body completo (substitui renderização padrão do tbody)"
      },
      {
        "name": "body-row",
        "scope": "key, row, rowIndex, cols, selected, pageIndex",
        "description": "Linha de body individual"
      },
      {
        "name": "body-cell",
        "scope": "key, row, col, value, selected, rowIndex, pageIndex",
        "description": "Célula de body individual"
      },
      {
        "name": "no-data",
        "scope": "icon, message, filter",
        "description": "Estado vazio — sem dados ou sem resultados de filtro"
      },
      {
        "name": "loading",
        "scope": null,
        "description": "Overlay de carregamento customizado"
      },
      {
        "name": "pagination",
        "scope": "scope",
        "description": "Área de paginação customizada"
      },
      {
        "name": "bottom",
        "scope": null,
        "description": "Área bottom completa (quando usado, substitui paginação padrão)"
      },
      {
        "name": "bottom-row",
        "scope": null,
        "description": "Linha adicional no rodapé da tabela"
      }
    ],
    "vModel": {
      "prop": "modelValue",
      "event": "update:modelValue"
    }
  },
