  "a11y": {
    "wcag": [
      {
        "criterion": "1.3.1",
        "level": "A",
        "implementation": "Sozinha, a raiz é um grupo rotulado pelo label; dentro do DssCompositionGroup, é o tabpanel da própria aba. A tabela é a do DssDataTableClaudeCode, que preserva cabeçalhos e células.",
        "verifiedBy": "test",
        "verified": true,
        "test": [
          "monta como grupo rotulado e compõe o DssDataTableClaudeCode",
          "dentro do grupo, é o tabpanel da própria aba"
        ]
      },
      {
        "criterion": "3.3.1",
        "level": "A",
        "implementation": "Coleção inválida mostra a mensagem em DssBanner de erro (texto + ícone), marca aria-invalid na raiz e aponta a mensagem por aria-describedby. Não nasce em erro antes de validar.",
        "verifiedBy": "test",
        "verified": true,
        "test": [
          "inválida: aria-invalid na raiz e descrição apontando a mensagem",
          "não nasce pintada de erro antes de validar"
        ]
      },
      {
        "criterion": "3.3.4",
        "level": "AA",
        "implementation": "Excluir, ativar e inativar pedem confirmação; nada é emitido antes do \"sim\", e cancelar não emite nada.",
        "verifiedBy": "test",
        "verified": true,
        "test": [
          "excluir pede confirmação e só emite depois do \"sim\"",
          "cancelar a confirmação não emite nada"
        ]
      }
    ],
    "aria": {
      "role": "group",
