  "a11y": {
    "wcag": [
      {
        "criterion": "1.3.1",
        "level": "A",
        "implementation": "Cada registro é um item de lista com os campos em dt/dd — rótulo e valor vinculados programaticamente, sem reaproveitar marcação de tabela.",
        "verifiedBy": "test",
        "verified": true,
        "test": [
          "usa lista, não tabela",
          "vincula rótulo e valor de cada campo por dt/dd"
        ]
      },
      {
        "criterion": "4.1.2",
        "level": "A",
        "implementation": "A raiz comunica busy e disabled; o revelador de campos declara aria-expanded e aponta aria-controls para o bloco que controla; o checkbox recebe nome contextual com o título do card.",
        "verifiedBy": "test",
        "verified": true,
        "test": [
          "comunica loading e disabled na raiz",
          "guarda campo oculto atrás do revelador, com aria-expanded e aria-controls",
          "dá título próprio ao card e nome contextual ao checkbox"
        ]
      },
      {
        "criterion": "4.1.3",
        "level": "AA",
        "implementation": "A contagem de registros é região viva aria-live=polite, porque filtrar e paginar mudam o conteúdo sem mover o foco.",
        "verifiedBy": "test",
        "verified": true,
        "test": "anuncia a contagem de registros em região viva"
      }
    ],
    "aria": {
      "role": "region"
    },
