  "api": {
    "props": [
      {
        "name": "src",
        "type": "string",
        "controlHint": "text",
        "description": "URL da imagem a ser carregada"
      },
      {
        "name": "alt",
        "type": "string",
        "controlHint": "text",
        "description": "Texto alternativo — obrigatório para imagens não-decorativas (WCAG 1.1.1)"
      },
      {
        "name": "decorative",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Marca a imagem como puramente decorativa."
      },
      {
        "name": "ratio",
        "type": "number | string",
        "controlHint": "text",
        "description": "Proporção de aspecto da imagem (largura / altura)."
      },
      {
        "name": "fit",
        "type": "'cover' | 'contain' | 'fill' | 'none' | 'scale-down'",
        "controlHint": "select",
        "description": "Como a imagem se ajusta ao container (object-fit)",
        "validValues": [
          "cover",
          "contain",
          "fill",
          "none",
          "scale-down"
        ]
      },
      {
        "name": "loading",
        "type": "'lazy' | 'eager'",
        "controlHint": "segmented",
        "description": "Comportamento de carregamento. `lazy` adia até a imagem entrar na viewport",
        "validValues": [
          "lazy",
          "eager"
        ]
      },
      {
        "name": "fallbackSrc",
        "type": "string",
        "controlHint": "text",
        "description": "Imagem de fallback exibida quando `src` falha"
      },
      {
        "name": "placeholderSrc",
        "type": "string",
        "controlHint": "text",
        "description": "LQIP (Low Quality Image Placeholder): imagem de baixa qualidade exibida"
      },
      {
        "name": "position",
        "type": "string",
        "controlHint": "text",
        "description": "Posição da imagem dentro do container (equivalente a background-position)"
      },
      {
        "name": "radius",
        "type": "'none' | 'sm' | 'md' | 'lg' | 'full'",
        "controlHint": "select",
        "description": "Raio de borda (border-radius) do container.",
        "validValues": [
          "none",
          "sm",
          "md",
          "lg",
          "full"
        ]
      },
      {
        "name": "noTransition",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Desativa a transição de fade-in ao carregar"
      }
    ],
    "emits": [
      {
        "name": "load",
        "description": "Disparado quando a imagem carregou com sucesso"
      },
      {
        "name": "error",
        "description": "Disparado quando o carregamento da imagem falhou"
      }
    ],
    "slots": [
      {
        "name": "default",
        "scope": null,
        "description": "Overlay sobre a imagem carregada — renderizado acima do `<img>`"
      },
      {
        "name": "loading",
        "scope": null,
        "description": "Indicador de carregamento customizado — padrão: DssSpinner centralizado"
      },
      {
        "name": "error",
        "scope": null,
        "description": "Estado de erro customizado — padrão: ícone `broken_image` centralizado"
      }
    ]
  },
