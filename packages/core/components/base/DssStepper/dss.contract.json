        "name": "bordered",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Adiciona borda ao container."
      },
      {
        "name": "brand",
        "type": "StepperBrand | null",
        "controlHint": "picker-brand",
        "default": "null",
        "description": "Marca Sansys (Hub, Water, Waste).",
