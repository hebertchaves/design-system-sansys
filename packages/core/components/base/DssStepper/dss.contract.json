          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label acessível para o stepper (aria-label)."
      }
    ],
    "emits": [
      {
        "name": "update:modelValue",
