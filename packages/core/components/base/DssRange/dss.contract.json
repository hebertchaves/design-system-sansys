  "api": {
    "props": [
      {
        "name": "modelValue",
        "type": "RangeValue",
        "controlHint": "text",
        "required": true,
        "description": "Valor atual do range (v-model). Obrigatório."
      },
      {
        "name": "min",
        "type": "number",
        "controlHint": "stepper",
        "default": "0",
        "description": "Valor mínimo permitido. @default 0"
      },
      {
        "name": "max",
        "type": "number",
        "controlHint": "stepper",
        "default": "100",
        "description": "Valor máximo permitido. @default 100"
      },
      {
        "name": "step",
        "type": "number",
        "controlHint": "stepper",
        "default": "1",
        "description": "Incremento do passo. @default 1"
      },
      {
        "name": "label",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Exibe tooltip flutuante com valor durante o drag. @default false"
      },
      {
        "name": "markers",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Exibe marcações de passo no track. @default false"
      },
      {
        "name": "dragRange",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Permite arrastar o intervalo inteiro (não apenas os thumbs individuais)."
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Modo compacto — reduz touch target para --dss-touch-target-sm (36px). @default false"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Desabilita toda interação. @default false"
      },
      {
        "name": "readonly",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Modo somente leitura — exibe o valor, mas não permite interação."
      },
      {
        "name": "error",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Ativa estado de erro. Exibe errorMessage quando fornecido. @default false"
      },
      {
        "name": "errorMessage",
        "type": "string",
        "controlHint": "text",
        "default": "",
        "description": "Mensagem de erro exibida abaixo do range quando error=true. @default ''"
      },
      {
        "name": "hint",
        "type": "string",
        "controlHint": "text",
        "default": "",
        "description": "Texto de ajuda exibido abaixo do range quando não há erro ativo. @default ''"
      },
      {
        "name": "brand",
        "type": "'hub' | 'water' | 'waste' | null",
        "controlHint": "segmented",
        "default": "null",
        "description": "Contexto de brand do produto.",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "default": "null",
        "description": "Tabindex customizado."
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Rótulo para leitores de tela (WCAG 1.3.1)."
      }
    ],
    "emits": [
      {
        "name": "update:modelValue",
        "payload": "RangeValue",
        "description": "Emitido continuamente durante o drag dos thumbs (v-model)."
      },
      {
        "name": "change",
        "payload": "RangeValue",
        "description": "Emitido quando o usuário solta o thumb (commit final)."
      }
    ],
