{
  "schemaId": "dss-component-contract@1",
  "name": "DssToggle",
  "version": "2.2",
  "identity": {
    "displayName": "Toggle",
    "tagline": "Interruptor para alternar um estado ligado/desligado.",
    "category": "Compact Control interativo",
    "classification": "Action",
    "phase": 1,
    "status": "sealed",
    "goldenReference": "DssChip",
    "goldenContext": "DssCheckbox"
  },
  "audit": {
    "status": "sealed",
    "date": "2026-02-05",
    "mode": "Auditor DSS v2.2",
    "sealPath": "docs/Compliance/seals/DssToggle/DSSTOGGLE_SELO_v2.2.md"
  },
  "api": {
    "props": [
      {
        "name": "modelValue",
        "type": "any",
        "controlHint": "text",
        "description": "Valor reativo do toggle (v-model)"
      },
      {
        "name": "trueValue",
        "type": "any",
        "controlHint": "text",
        "default": true,
        "description": "Valor quando toggle esta ativo (on)"
      },
      {
        "name": "falseValue",
        "type": "any",
        "controlHint": "text",
        "default": false,
        "description": "Valor quando toggle esta inativo (off)"
      },
      {
        "name": "val",
        "type": "any",
        "controlHint": "text",
        "description": "Valor para uso em array mode (grupo de toggles)"
      },
      {
        "name": "label",
        "type": "string",
        "controlHint": "text",
        "default": "",
        "description": "Texto do label (alternativa ao slot default)"
      },
      {
        "name": "leftLabel",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Posiciona o label a esquerda do toggle"
      },
      {
        "name": "color",
        "type": "ToggleColor",
        "controlHint": "picker-color",
        "default": "primary",
        "description": "Cor do toggle quando ativo",
        "validValues": [
          "primary",
          "secondary",
          "tertiary",
          "accent",
          "positive",
          "negative",
          "warning",
          "info"
        ]
      },
      {
        "name": "size",
        "type": "ToggleSize",
        "controlHint": "select",
        "default": "md",
        "description": "Tamanho do toggle",
        "validValues": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl"
        ]
      },
      {
        "name": "keepColor",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Escape hatch de cor: mantem a cor (semantica/brand) no track tambem no"
      },
      {
        "name": "checkedIcon",
        "type": "string",
        "controlHint": "text",
        "description": "Nome do glifo exibido DENTRO do thumb quando LIGADO, composto via DssIcon."
      },
      {
        "name": "disable",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Desabilita o toggle"
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Modo denso - reduz densidade visual"
      },
      {
        "name": "error",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Estado de erro"
      },
      {
        "name": "errorMessage",
        "type": "string",
        "controlHint": "text",
        "description": "Mensagem de erro exibida quando error=true"
      },
      {
        "name": "brand",
        "type": "ToggleBrand | null",
        "controlHint": "picker-brand",
        "default": "null",
        "description": "Marca do produto (Hub, Water, Waste)",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "description": "Tabindex customizado para o input nativo"
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label de acessibilidade customizado para screen readers"
      }
    ],
    "emits": [
      {
        "name": "update:modelValue",
        "payload": "any",
        "description": "Emitido quando o valor do toggle muda"
      }
    ],
    "slots": [
      {
        "name": "default",
        "scope": null,
        "description": "Conteudo customizado do label"
      }
    ],
    "vModel": {
      "prop": "modelValue",
      "event": "update:modelValue"
    }
  },
