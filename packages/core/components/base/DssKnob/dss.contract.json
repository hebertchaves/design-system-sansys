{
  "schemaId": "dss-component-contract@1",
  "name": "DssKnob",
  "version": "0",
  "identity": {
    "displayName": "Knob",
    "tagline": "Controle circular para ajustar um valor dentro de um intervalo.",
    "category": "Controle rotativo para seleção de valores numéricos",
    "classification": "Action",
    "phase": 2,
    "status": "sealed",
    "goldenReference": "DssChip",
    "goldenContext": "DssSlider"
  },
  "audit": {
    "status": "sealed",
    "date": "1970-01-01",
    "sealPath": "docs/Compliance/seals/DssKnob/DSSKNOB_SELO_v2.2.md"
  },
  "api": {
    "props": [
      {
        "name": "modelValue",
        "type": "number",
        "controlHint": "stepper",
        "required": true,
        "description": "Valor atual do knob (obrigatório, bidireccional via v-model)"
      },
      {
        "name": "min",
        "type": "number",
        "controlHint": "stepper",
        "description": "Valor mínimo permitido"
      },
      {
        "name": "max",
        "type": "number",
        "controlHint": "stepper",
        "description": "Valor máximo permitido"
      },
      {
        "name": "innerMin",
        "type": "number",
        "controlHint": "stepper",
        "description": "Mínimo interno (restringe o modelo dentro do intervalo da trilha)"
      },
      {
        "name": "innerMax",
        "type": "number",
        "controlHint": "stepper",
        "description": "Máximo interno (restringe o modelo dentro do intervalo da trilha)"
      },
      {
        "name": "step",
        "type": "number",
        "controlHint": "stepper",
        "description": "Incremento de valor por interação"
      },
      {
        "name": "reverse",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Inverte a direção do progresso"
      },
      {
        "name": "instantFeedback",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Desativa animação ao mudar o valor (sem transição de arco)"
      },
      {
        "name": "readonly",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Apenas leitura — não editável, sem feedback visual de desabilitado"
      },
      {
        "name": "disable",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Desabilitado — não interativo, com opacidade reduzida"
      },
      {
        "name": "thickness",
        "type": "number",
        "controlHint": "stepper",
        "description": "Espessura do arco (razão 0–1 do raio)"
      },
      {
        "name": "angle",
        "type": "number",
        "controlHint": "stepper",
        "description": "Ângulo inicial do arco em graus"
      },
      {
        "name": "rounded",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Terminações arredondadas no arco de progresso"
      },
      {
        "name": "tabindex",
        "type": "number | string",
        "controlHint": "text",
        "description": "Índice de tabulação para navegação por teclado"
      },
      {
        "name": "size",
        "type": "string",
        "controlHint": "text",
        "description": "Tamanho visual do knob como string CSS (ex: '48px', '4rem')"
      },
      {
        "name": "name",
        "type": "string",
        "controlHint": "text",
        "description": "Nome do campo para formulários nativos"
      },
      {
        "name": "showValue",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Exibe o conteúdo do slot default no centro do knob"
      },
      {
        "name": "brand",
        "type": "KnobBrand",
        "controlHint": "picker-brand",
        "description": "Contexto de brand DSS",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      }
    ],
    "emits": [
      {
        "name": "update:modelValue",
        "payload": "number",
        "description": "Emitido quando o valor muda durante interação (para v-model)"
      },
      {
        "name": "change",
        "payload": "number",
        "description": "Emitido quando a interação finaliza (mouse/touch release)"
      },
      {
        "name": "drag-value",
        "payload": "number",
        "description": "Emitido continuamente durante drag com o valor em tempo real"
      }
    ],
    "slots": [
      {
        "name": "default",
        "scope": null,
        "description": "Conteúdo exibido no centro do knob."
      }
    ],
    "vModel": {
      "prop": "modelValue",
      "event": "update:modelValue"
    }
  },
