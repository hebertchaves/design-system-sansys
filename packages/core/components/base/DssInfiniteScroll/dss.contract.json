  "api": {
    "props": [
      {
        "name": "offset",
        "type": "number",
        "controlHint": "stepper",
        "description": "Offset em pixels a partir do fundo do container para acionar o carregamento"
      },
      {
        "name": "debounce",
        "type": "number",
        "controlHint": "stepper",
        "description": "Debounce em milissegundos para o evento de scroll"
      },
      {
        "name": "initialIndex",
        "type": "number",
        "controlHint": "stepper",
        "description": "Índice inicial de paginação passado para o primeiro evento @load"
      },
      {
        "name": "scrollTarget",
        "type": "string | Element | null",
        "controlHint": "text",
        "description": "Seletor CSS ou referência DOM para o container de scroll pai"
      },
      {
        "name": "reverse",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Modo reverso: carrega ao atingir o topo (ex: chats, feeds de mensagens)"
      },
      {
        "name": "disable",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Desabilita a detecção de scroll e o acionamento de @load"
      }
    ],
    "emits": [
      {
        "name": "load",
        "payload": "number",
        "description": "Disparado quando o componente precisa carregar mais conteúdo."
      }
    ],
    "slots": [
      {
        "name": "default",
        "scope": null,
        "description": "Conteúdo da lista que cresce a cada carregamento"
      },
      {
        "name": "loading",
        "scope": null,
        "description": "Indicador de carregamento customizado (padrão: DssSpinner)"
      },
      {
        "name": "no-more",
        "scope": null,
        "description": "Mensagem exibida quando done(true) é chamado — não há mais itens"
      }
    ],
    "exposedRefs": [
      {
        "name": "poll",
        "type": "() => void",
        "description": "Verifica posição de scroll e carrega mais se necessário"
      },
      {
        "name": "trigger",
        "type": "() => void",
        "description": "Força carregamento independente da posição de scroll"
      },
      {
        "name": "reset",
        "type": "() => void",
        "description": "Reseta o índice para 0 e reativa o carregamento"
      },
      {
        "name": "stop",
        "type": "() => void",
        "description": "Para o funcionamento do infinite scroll"
      },
      {
        "name": "resume",
        "type": "() => void",
        "description": "Retoma o funcionamento e verifica posição"
      },
      {
        "name": "setIndex",
        "type": "(index: number) => void",
        "description": "Define o índice de paginação manualmente"
      },
      {
        "name": "isLoading",
        "type": "Readonly<boolean>",
        "description": "Estado reativo: carregamento em progresso"
      },
      {
        "name": "noMore",
        "type": "Readonly<boolean>",
        "description": "Estado reativo: sem mais itens para carregar"
      }
    ]
  },
