  "api": {
    "props": [
      {
        "name": "label",
        "type": "string",
        "controlHint": "text",
        "description": "Texto principal do item"
      },
      {
        "name": "caption",
        "type": "string",
        "controlHint": "text",
        "description": "Texto secundario (subtitulo) abaixo do label"
      },
      {
        "name": "clickable",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Torna o item clicavel (adiciona hover, active, focus, touch target)"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Estado desabilitado (requer clickable)"
      },
      {
        "name": "active",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Estado ativo (destaque visual, requer clickable)"
      },
      {
        "name": "density",
        "type": "ItemDensity",
        "controlHint": "segmented",
        "description": "Densidade do item",
        "validValues": [
          "default",
          "compact"
        ]
      },
      {
        "name": "color",
        "type": "ItemColor | null",
        "controlHint": "picker-color",
        "description": "Cor semantica do texto do label",
        "validValues": [
          "primary",
          "secondary",
          "tertiary",
          "accent",
          "positive",
          "negative",
          "warning",
          "info"
        ]
      },
      {
        "name": "inset",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Recuo do conteudo para alinhar com itens que possuem leading"
      },
      {
        "name": "divider",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Mostra divider (borda inferior)"
      },
      {
        "name": "brand",
        "type": "ItemBrand | null",
        "controlHint": "picker-brand",
        "description": "Brand override (Hub, Water, Waste)",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label de acessibilidade customizado para screen readers"
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "description": "Tabindex customizado (sobrescreve logica automatica)"
      },
      {
        "name": "leadingDecorative",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Marca o conteudo do slot leading como decorativo (aria-hidden=\"true\")"
      },
      {
        "name": "trailingDecorative",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Marca o conteudo do slot trailing como decorativo (aria-hidden=\"true\")"
      }
    ],
    "emits": [
      {
        "name": "click",
        "payload": "MouseEvent | KeyboardEvent",
        "description": "Emitido quando o item e clicado (requer clickable=true)"
      }
    ],
    "slots": [
      {
        "name": "default",
        "scope": null,
        "description": "Conteudo principal do item (substitui label + caption)"
      },
      {
        "name": "leading",
        "scope": null,
        "description": "Area esquerda do item (icone, avatar, checkbox, etc.)"
      },
      {
        "name": "trailing",
        "scope": null,
        "description": "Area direita do item (icone, badge, toggle, etc.)"
      }
    ]
  },
