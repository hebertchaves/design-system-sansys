  "api": {
    "props": [
      {
        "name": "open",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Controla a visibilidade do popup (v-model:open)."
      },
      {
        "name": "breakpoint",
        "type": "number | string",
        "controlHint": "text",
        "default": "450",
        "description": "Breakpoint em pixels para alternar entre QMenu (≥) e QDialog (<)."
      },
      {
        "name": "target",
        "type": "string | Element | boolean | null",
        "controlHint": "text",
        "description": "Elemento alvo para posicionamento. Pode ser seletor CSS string,"
      },
      {
        "name": "noParentEvent",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Impede o QPopupProxy de adicionar listener de evento no elemento pai."
      },
      {
        "name": "contextMenu",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Exibe o popup ao clique-direito do mouse (context menu)."
      },
      {
        "name": "persistent",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Impede o fechamento do popup ao clicar fora ou pressionar ESC."
      },
      {
        "name": "noFocus",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Impede que o popup capture o foco ao abrir."
      },
      {
        "name": "noRefocus",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Impede que o foco retorne ao elemento trigger ao fechar."
      },
      {
        "name": "autoClose",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Fecha o popup automaticamente ao clicar em qualquer elemento interno."
      },
      {
        "name": "anchor",
        "type": "PopupProxyPosition",
        "controlHint": "select",
        "description": "Ponto de ancoragem no elemento trigger.",
        "validValues": [
          "top left",
          "top middle",
          "top right",
          "top start",
          "top end",
          "center left",
          "center middle",
          "center right",
          "center start",
          "center end",
          "bottom left",
          "bottom middle",
          "bottom right",
          "bottom start",
          "bottom end"
        ]
      },
      {
        "name": "self",
        "type": "PopupProxyPosition",
        "controlHint": "select",
        "description": "Ponto de alinhamento do próprio popup.",
        "validValues": [
          "top left",
          "top middle",
          "top right",
          "top start",
          "top end",
          "center left",
          "center middle",
          "center right",
          "center start",
          "center end",
          "bottom left",
          "bottom middle",
          "bottom right",
          "bottom start",
          "bottom end"
        ]
      },
      {
        "name": "offset",
        "type": "[number, number]",
        "controlHint": "text",
        "description": "Deslocamento [x, y] em pixels a partir do ponto de ancoragem."
      },
      {
        "name": "fit",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Ajusta a largura do popup para ser igual à largura do elemento trigger."
      },
      {
        "name": "cover",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Cobre completamente o elemento trigger."
      },
      {
        "name": "maxHeight",
        "type": "string",
        "controlHint": "text",
        "description": "Altura máxima do popup. Aceita string CSS (ex: '300px', '50vh')."
      },
      {
        "name": "maxWidth",
        "type": "string",
        "controlHint": "text",
        "description": "Largura máxima do popup. Aceita string CSS (ex: '400px', '80vw')."
      },
      {
        "name": "transitionShow",
        "type": "string",
        "controlHint": "text",
        "description": "Nome da transição de entrada do popup."
      },
      {
        "name": "transitionHide",
        "type": "string",
        "controlHint": "text",
        "description": "Nome da transição de saída do popup."
      },
      {
        "name": "scrollTarget",
        "type": "string | Element",
        "controlHint": "text",
        "description": "Elemento para escutar eventos de scroll."
      }
    ],
    "emits": [],
    "slots": [
      {
        "name": "default",
        "scope": null,
        "description": "Conteúdo do popup."
      }
    ]
  },
