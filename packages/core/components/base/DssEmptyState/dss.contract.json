  "a11y": {
    "wcag": [
      {
        "criterion": "4.1.3",
        "level": "AA",
        "implementation": "REBAIXADA (ago/2026, apos duas auditorias). O componente EMITE role=status + aria-live=polite quando announce=true — isso e o que o .test.js verifica e o unico fato que esta claim afirma. NAO se afirma mais que o anuncio OCORRE ao substituir um resultado: no uso canonico (v-if montando o componente) a regiao e o texto entram no DOM no mesmo commit, e varias ATs nao anunciam regiao inserida ja preenchida. Duas auditorias tentaram verificar e nenhuma teve leitor de tela disponivel. REQUISITO DE USO: para anuncio confiavel, o consumidor mantem um conteiner com aria-live persistente em volta da area que troca. Ver DssEmptyState.md secao 8.",
        "verifiedBy": "test"
      },
      {
        "criterion": "1.4.3",
        "level": "AA",
        "implementation": "Titulo em --dss-text-primary e descricao em --dss-text-secondary sobre superficie neutra. A ancora mede o ELO MAIS FRACO (descricao secundaria); o icone usa a mesma --dss-text-secondary. NAO se usa --dss-text-muted: apesar do nome ele aponta para --dss-dark-disable.",
        "verifiedBy": "css"
      },
      {
        "criterion": "1.4.1",
        "level": "A",
        "implementation": "A informacao esta no texto do titulo, nunca apenas no icone; o icone e emitido como decorativo e nao e anunciado.",
        "verifiedBy": "aria"
      }
    ],
