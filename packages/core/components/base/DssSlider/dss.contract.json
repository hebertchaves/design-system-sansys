      {
        "name": "error",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Ativa estado de erro"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Desabilita o slider"
      },
      {
        "name": "readonly",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Slider somente leitura"
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Modo denso — reduz a área vertical do controle"
      },
      {
        "name": "vertical",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Orientação vertical do slider"
      },
      {
        "name": "reverse",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Inverte a direção do slider"
      },
      {
        "name": "brand",
        "type": "'hub' | 'water' | 'waste' | null",
        "controlHint": "segmented",
        "default": "null",
        "description": "Marca do produto (Hub, Water, Waste)",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "description": "Tabindex customizado para o QSlider"
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label de acessibilidade para screen readers"
      }
    ],
    "emits": [
