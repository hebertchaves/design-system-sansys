  "name": "DssButton",
  "version": "0",
  "identity": {
    "displayName": "Button",
    "tagline": "Aciona uma ação primária ou secundária do formulário ou da tela.",
    "category": "Action",
    "classification": "Action",
    "phase": 1,
    "status": "sealed",
    "goldenReference": "DssButton",
    "goldenContext": "DssButton"
  },
  "audit": {
    "status": "sealed",
