    "sealPath": "docs/Compliance/seals/DssButton/DSS_BUTTON_SELO_v2.2.md"
  },
  "api": {
    "props": [
      {
        "name": "label",
        "type": "string",
        "controlHint": "text",
        "description": "Texto do botão (alternativa ao slot default)"
      },
      {
        "name": "icon",
        "type": "string",
        "controlHint": "text",
        "description": "Ícone à esquerda (Material Icons)"
      },
      {
        "name": "iconRight",
        "type": "string",
        "controlHint": "text",
        "description": "Ícone à direita (Material Icons)"
      },
      {
        "name": "variant",
        "type": "ButtonVariant",
        "controlHint": "select",
        "description": "Variante visual do botão",
        "validValues": [
          "elevated",
          "flat",
          "outline",
          "unelevated",
          "push",
          "glossy"
        ]
      },
      {
        "name": "color",
        "type": "ButtonColor",
        "controlHint": "picker-color",
        "description": "Cor semântica do botão",
        "validValues": [
          "primary",
          "secondary",
          "tertiary",
          "accent",
          "positive",
          "negative",
          "warning",
          "info"
        ]
      },
      {
        "name": "size",
        "type": "ButtonSize",
        "controlHint": "select",
        "description": "Tamanho do botão",
        "validValues": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl"
        ]
      },
      {
        "name": "round",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Botão completamente circular"
      },
      {
        "name": "square",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Botão completamente quadrado (sem border-radius)"
      },
      {
        "name": "loading",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Estado de carregamento (mostra spinner)"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Estado desabilitado"
      },
      {
        "name": "percentage",
        "type": "number | null",
        "controlHint": "text",
        "description": "Porcentagem de progresso (0-100)"
      },
      {
        "name": "darkPercentage",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Usar indicador escuro na barra de progresso"
      },
      {
        "name": "type",
        "type": "ButtonType",
        "controlHint": "segmented",
        "description": "Tipo nativo do botão HTML",
        "validValues": [
          "button",
          "submit",
          "reset"
        ]
      },
      {
        "name": "to",
        "type": "RouteLocationRaw | null",
        "controlHint": "text",
        "description": "Rota Vue Router (transforma em router-link)"
      },
      {
        "name": "replace",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Usar router.replace ao invés de router.push"
      },
      {
        "name": "brand",
        "type": "ButtonBrand | null",
        "controlHint": "picker-brand",
        "description": "Brand override (Hub, Water, Waste)",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Modo compacto (reduz padding)"
      },
      {
        "name": "noCaps",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Desabilita text-transform: uppercase"
      },
      {
        "name": "align",
        "type": "ButtonAlign",
        "controlHint": "select",
        "description": "Alinhamento interno do conteúdo",
        "validValues": [
          "left",
          "center",
          "right",
          "between",
          "around",
          "evenly"
        ]
      },
      {
        "name": "stack",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Empilha ícone e label verticalmente"
      },
      {
        "name": "stretch",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Estica o botão para ocupar largura total"
      },
      {
        "name": "noWrap",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Previne quebra de linha do label"
      },
      {
        "name": "padding",
        "type": "string | null",
        "controlHint": "text",
        "description": "Padding customizado (ex: \"16px 32px\")"
      },
      {
        "name": "ripple",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Ativa efeito ripple ao clicar"
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "description": "Tabindex customizado"
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label de acessibilidade customizado para screen readers"
      }
    ],
    "emits": [
      {
        "name": "click",
        "payload": "MouseEvent",
        "description": "Emitido quando o botão é clicado"
      }
    ],
    "slots": [
      {
        "name": "default",
        "scope": null,
        "description": "Conteúdo principal do botão."
      },
      {
        "name": "icon-left",
        "scope": null,
        "description": "Ícone à esquerda do conteúdo (precede a prop icon — CCI §3.2)."
      },
      {
        "name": "icon-right",
        "scope": null,
        "description": "Ícone à direita do conteúdo (precede a prop iconRight — CCI §3.2)."
      }
    ]
  },
