      },
      {
        "name": "icon",
        "type": "string",
        "controlHint": "text",
        "description": "Icone a esquerda (Material Icons)"
      },
      {
        "name": "iconRight",
        "type": "string",
        "controlHint": "text",
        "description": "Icone a direita (Material Icons)"
      },
      {
        "name": "iconRemove",
        "type": "string",
        "controlHint": "text",
        "description": "Icone customizado para o botao de remover"
      },
      {
        "name": "iconSelected",
        "type": "string",
        "controlHint": "text",
        "description": "Icone customizado para estado selecionado"
      },
      {
        "name": "variant",
        "type": "ChipVariant",
        "controlHint": "segmented",
        "description": "Variante visual do chip",
        "validValues": [
          "filled",
          "outline",
          "flat"
        ]
      },
      {
        "name": "color",
        "type": "ChipColor",
        "controlHint": "picker-color",
        "description": "Cor semantica do chip",
        "validValues": [
          "primary",
          "secondary",
          "tertiary",
          "accent",
          "positive",
          "negative",
          "warning",
          "info",
          "neutral"
        ]
      },
      {
        "name": "size",
        "type": "ChipSize",
        "controlHint": "segmented",
        "description": "Tamanho do chip",
        "validValues": [
          "xs",
          "sm",
          "md",
          "lg"
        ]
      },
      {
        "name": "round",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Chip completamente circular (pill shape)"
      },
      {
        "name": "square",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Chip completamente quadrado (sem border-radius)"
      },
      {
        "name": "selected",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Estado selecionado (mostra icone de check)"
      },
      {
        "name": "disable",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Estado desabilitado"
      },
      {
        "name": "clickable",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Torna o chip clicavel (adiciona hover effects e emite 'click')"
      },
      {
        "name": "removable",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Mostra icone de remover e emite evento 'remove' ao clicar"
      },
      {
        "name": "brand",
        "type": "ChipBrand | null",
        "controlHint": "picker-brand",
        "description": "Brand override (Hub, Water, Waste)",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Modo compacto (reduz padding)"
      },
      {
        "name": "ripple",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Ativa efeito ripple ao clicar"
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "description": "Tabindex customizado"
      },
      {
        "name": "role",
        "type": "string",
        "controlHint": "text",
        "description": "Papel ARIA do chip. **O papel depende do contexto, não do componente.**"
      },
      {
        "name": "removeAriaLabel",
        "type": "string",
        "controlHint": "text",
        "default": "Remove",
        "description": "Label de acessibilidade para o botao de remover"
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label de acessibilidade customizado para screen readers"
      }
    ],
    "emits": [
      {
        "name": "click",
        "payload": "MouseEvent",
        "description": "Emitido quando o chip e clicado (requer clickable=true)"
      },
      {
        "name": "remove",
        "payload": "MouseEvent",
        "description": "Emitido quando o botao de remover e clicado"
      },
      {
        "name": "update:selected",
        "payload": "boolean",
        "description": "Emitido quando o estado selected muda"
      }
    ],
    "slots": [
      {
        "name": "default",
        "scope": null,
        "description": "Conteudo principal do chip"
      },
      {
        "name": "icon-left",
        "scope": null,
        "description": "Ícone à esquerda (precede a prop/ícone de seleção — CCI §3.2)"
      },
      {
        "name": "icon-right",
        "scope": null,
        "description": "Ícone à direita (precede o botão de remover — CCI §3.2)"
      }
    ]
  },
