  },
  "api": {
    "props": [
      {
        "name": "modelValue",
        "type": "string",
        "controlHint": "text",
        "description": "Valor do textarea (v-model)"
      },
      {
        "name": "variant",
        "type": "TextareaVariant",
        "controlHint": "segmented",
        "default": "outlined",
        "description": "Variante visual do textarea",
        "validValues": [
          "filled",
          "outlined",
          "standout",
          "borderless"
        ]
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Versão compacta (menor altura inicial e espaçamentos reduzidos)"
      },
      {
        "name": "brand",
        "type": "TextareaBrand | null",
        "controlHint": "picker-brand",
        "default": "null",
        "description": "Marca Sansys (Hub, Water, Waste)",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "label",
        "type": "string",
        "controlHint": "text",
        "description": "Label do textarea (floating label)"
      },
      {
        "name": "stackLabel",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Label sempre visível no topo (não flutua)"
      },
      {
        "name": "placeholder",
        "type": "string",
        "controlHint": "text",
        "description": "Placeholder do textarea"
      },
      {
        "name": "hint",
        "type": "string",
        "controlHint": "text",
        "description": "Texto de ajuda exibido abaixo do textarea"
      },
      {
        "name": "errorMessage",
        "type": "string",
        "controlHint": "text",
        "description": "Mensagem de erro exibida abaixo do textarea"
      },
      {
        "name": "error",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Estado de erro (muda cor para negativo)"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Textarea desabilitado"
      },
      {
        "name": "readonly",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Textarea somente leitura"
      },
      {
        "name": "loading",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Mostra indicador de loading (spinner)"
      },
      {
        "name": "required",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Textarea obrigatório (adiciona aria-required)"
      },
      {
        "name": "clearable",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Mostra botão de limpar (×) quando há valor"
      },
      {
        "name": "autogrow",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Cresce automaticamente conforme o conteúdo é digitado."
      },
      {
        "name": "rows",
        "type": "number | string",
        "controlHint": "text",
        "default": "1",
        "description": "Número de linhas visíveis inicialmente."
      },
      {
        "name": "maxHeight",
        "type": "string",
        "controlHint": "text",
        "default": "undefined (sem limite)",
        "description": "Altura máxima do campo (CSS value, ex.: '300px', '50vh')."
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label de acessibilidade customizado para screen readers."
      },
      {
        "name": "clearAriaLabel",
        "type": "string",
        "controlHint": "text",
        "default": "Clear textarea",
        "description": "Label de acessibilidade para o botão de limpar"
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "default": "null (usa 0 por padrão)",
        "description": "Tabindex customizado"
      }
    ],
    "emits": [
      {
        "name": "update:modelValue",
        "payload": "string",
        "description": "Emitido quando o valor do textarea muda (v-model)"
      },
      {
        "name": "focus",
        "payload": "FocusEvent",
        "description": "Emitido quando o textarea recebe foco"
      },
      {
        "name": "blur",
        "payload": "FocusEvent",
        "description": "Emitido quando o textarea perde foco"
      },
      {
        "name": "clear",
        "description": "Emitido quando o textarea é limpo via botão clear"
      }
    ],
