  "name": "DssFile",
  "version": "2.4.0",
  "identity": {
    "displayName": "File",
    "tagline": "Campo de seleção de arquivos com validação de tipo e tamanho.",
    "category": "Action Control — campo de seleção de arquivos",
    "classification": "Action",
    "phase": 1,
    "status": "sealed",
    "goldenReference": "DssChip",
    "goldenContext": "DssInput"
  },
  "audit": {
    "status": "sealed",
    "date": "2026-03-24",
    "mode": "full-2-cycles",
    "sealPath": "docs/Compliance/seals/DssFile/DSSFILE_SELO_v2.2.md"
  },
  "api": {
    "props": [
      {
        "name": "modelValue",
        "type": "File | File[] | null",
        "controlHint": "text",
        "description": "Arquivo(s) selecionado(s) (v-model)"
      },
      {
        "name": "multiple",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Permite seleção de múltiplos arquivos"
      },
      {
        "name": "accept",
        "type": "string",
        "controlHint": "text",
        "description": "Tipos de arquivo aceitos (MIME types ou extensões)"
      },
      {
        "name": "maxFiles",
        "type": "number",
        "controlHint": "stepper",
        "default": "undefined (ilimitado)",
        "description": "Número máximo de arquivos (apenas quando `multiple=true`)"
      },
      {
        "name": "maxFileSize",
        "type": "number",
        "controlHint": "stepper",
        "default": "undefined (ilimitado)",
        "description": "Tamanho máximo por arquivo em bytes"
      },
      {
        "name": "variant",
        "type": "FileVariant",
        "controlHint": "segmented",
        "default": "outlined",
        "description": "Variante visual do campo",
        "validValues": [
          "filled",
          "outlined",
          "standout",
          "borderless"
        ]
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Versão compacta (menor altura)"
      },
      {
        "name": "brand",
        "type": "FileBrand | null",
        "controlHint": "picker-brand",
        "default": "null",
        "description": "Marca Sansys (Hub, Water, Waste)",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "label",
        "type": "string",
        "controlHint": "text",
        "description": "Label do campo (floating label)"
      },
      {
        "name": "stackLabel",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Label sempre visível no topo (não flutua)"
      },
      {
        "name": "placeholder",
        "type": "string",
        "controlHint": "text",
        "description": "Placeholder exibido quando nenhum arquivo selecionado"
      },
      {
        "name": "hint",
        "type": "string",
        "controlHint": "text",
        "description": "Texto de ajuda exibido abaixo do campo"
      },
      {
        "name": "errorMessage",
        "type": "string",
        "controlHint": "text",
        "description": "Mensagem de erro exibida abaixo do campo"
      },
      {
        "name": "error",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Estado de erro (muda cor para negativo)"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Campo desabilitado"
      },
      {
        "name": "readonly",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Campo somente leitura (não pode selecionar novos arquivos)"
      },
      {
        "name": "loading",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Mostra indicador de carregamento e bloqueia a interação."
      },
      {
        "name": "required",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Campo obrigatório. Emite `aria-required` e marca a label com asterisco."
      },
      {
        "name": "clearable",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Mostra botão de limpar quando há arquivo selecionado"
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label de acessibilidade customizado para screen readers"
      },
      {
        "name": "clearAriaLabel",
        "type": "string",
        "controlHint": "text",
        "default": "Remover arquivo selecionado",
        "description": "Label do botão de limpar para screen readers"
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "default": "null (usa 0 por padrão)",
        "description": "Tabindex customizado"
      }
    ],
    "emits": [
      {
        "name": "update:modelValue",
        "payload": "File | File[] | null",
        "description": "Emitido quando arquivo(s) selecionado(s) mudam (v-model)"
      },
      {
        "name": "rejected",
        "payload": "{ failedPropValidation: string; file: File }[]",
        "description": "Emitido quando arquivos são rejeitados (maxFileSize, accept, maxFiles)"
      },
      {
        "name": "focus",
        "payload": "FocusEvent",
        "description": "Emitido quando o campo recebe foco"
      },
      {
        "name": "blur",
        "payload": "FocusEvent",
        "description": "Emitido quando o campo perde foco"
      },
      {
        "name": "clear",
        "description": "Emitido quando a seleção é limpa via botão clear"
      }
    ],
    "slots": [
      {
        "name": "prepend",
        "scope": null,
        "description": "Conteúdo dentro do campo, à esquerda (ex: ícone de anexo)"
      },
      {
        "name": "append",
        "scope": null,
        "description": "Conteúdo dentro do campo, à direita (ex: botão de upload)"
      },
      {
        "name": "before",
        "scope": null,
        "description": "Conteúdo ANTES de toda a estrutura do campo — fora da borda."
      },
      {
        "name": "after",
        "scope": null,
        "description": "Conteúdo APÓS toda a estrutura do campo — fora da borda."
      },
      {
        "name": "label",
        "scope": null,
        "description": "Label personalizada (substitui a prop `label`)."
      },
      {
        "name": "error",
        "scope": null,
        "description": "Mensagem de erro customizada"
      },
      {
        "name": "hint",
        "scope": null,
        "description": "Texto de ajuda customizado"
      }
    ],
    "exposedRefs": [
      {
        "name": "pickFiles",
        "type": "() => void",
        "description": "Abre o seletor de arquivos nativo"
      },
      {
        "name": "removeAtIndex",
        "type": "(index: number) => void",
        "description": "Remove arquivo por índice (modo múltiplo)"
      },
      {
        "name": "removeFile",
        "type": "(file: File) => void",
        "description": "Remove arquivo específico"
      },
      {
        "name": "focus",
        "type": "() => void",
        "description": "Foca no campo"
      },
      {
        "name": "blur",
        "type": "() => void",
        "description": "Remove foco do campo"
      }
    ],
    "vModel": {
      "prop": "modelValue",
      "event": "update:modelValue"
    }
  },
