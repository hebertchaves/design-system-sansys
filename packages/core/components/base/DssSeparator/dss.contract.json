  "api": {
    "props": [
      {
        "name": "vertical",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Define orientação vertical. Default: false (horizontal)"
      },
      {
        "name": "inset",
        "type": "SeparatorInset",
        "controlHint": "segmented",
        "description": "Aplica indentação nas extremidades do separador.",
        "validValues": [
          "item",
          "item-thumbnail"
        ]
      },
      {
        "name": "spaced",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Aplica margem ao redor do separador (separação com o conteúdo adjacente)."
      },
      {
        "name": "color",
        "type": "SeparatorColor",
        "controlHint": "picker-color",
        "description": "Cor semântica da linha. Default: 'default' (var(--dss-gray-200))",
        "validValues": [
          "subtle",
          "default",
          "strong",
          "primary",
          "secondary"
        ]
      },
      {
        "name": "size",
        "type": "SeparatorSize",
        "controlHint": "segmented",
        "description": "Espessura da linha. Default: 'thin' (1px)",
        "validValues": [
          "hairline",
          "thin",
          "md",
          "thick"
        ]
      },
      {
        "name": "ariaHidden",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Remove o separador da árvore de acessibilidade."
      }
    ],
