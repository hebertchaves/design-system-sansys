  "api": {
    "props": [
      {
        "name": "nodes",
        "type": "DssTreeNode[]",
        "controlHint": "text",
        "required": true,
        "description": "Dados hierárquicos da árvore (obrigatório)"
      },
      {
        "name": "nodeKey",
        "type": "string",
        "controlHint": "text",
        "description": "Campo identificador único de cada nó"
      },
      {
        "name": "labelKey",
        "type": "string",
        "controlHint": "text",
        "description": "Campo do texto exibido de cada nó"
      },
      {
        "name": "childrenKey",
        "type": "string",
        "controlHint": "text",
        "description": "Campo dos filhos de cada nó"
      },
      {
        "name": "selected",
        "type": "string | null",
        "controlHint": "text",
        "description": "Nó selecionado (v-model:selected)."
      },
      {
        "name": "expanded",
        "type": "string[]",
        "controlHint": "text",
        "description": "Nós expandidos (v-model:expanded)."
      },
      {
        "name": "ticked",
        "type": "string[]",
        "controlHint": "text",
        "description": "Nós marcados/checked (v-model:ticked)."
      },
      {
        "name": "accordion",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Modo acordeão: apenas um nó de cada nível expandido por vez"
      },
      {
        "name": "noConnectors",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Oculta as linhas de conexão entre nós"
      },
      {
        "name": "defaultExpandAll",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Expande todos os nós ao montar o componente"
      },
      {
        "name": "filter",
        "type": "string",
        "controlHint": "text",
        "description": "String de filtro para busca client-side"
      },
      {
        "name": "filterMethod",
        "type": "(node: DssTreeNode, filter: string, update: (fn: () => void) => void) => boolean",
        "controlHint": "text",
        "description": "Função customizada de filtro"
      },
      {
        "name": "tickStrategy",
        "type": "DssTreeTickStrategy",
        "controlHint": "segmented",
        "description": "Estratégia de seleção via checkbox",
        "validValues": [
          "none",
          "strict",
          "leaf",
          "leaf-filtered"
        ]
      },
      {
        "name": "noNodesLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Mensagem quando não há nós"
      },
      {
        "name": "noResultsLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Mensagem quando filtro não retorna resultados"
      },
      {
        "name": "iconSize",
        "type": "string",
        "controlHint": "text",
        "description": "Tamanho dos ícones de expansão"
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "description": "Modo compacto (equivale ao dense do Quasar)"
      }
    ],
    "emits": [
      {
        "name": "update:selected",
        "payload": "string | null",
        "description": "Nó selecionado mudou"
      },
      {
        "name": "update:expanded",
        "payload": "string[]",
        "description": "Nós expandidos mudaram"
      },
      {
        "name": "update:ticked",
        "payload": "string[]",
        "description": "Nós marcados mudaram"
      },
      {
        "name": "lazy-load",
        "payload": "DssTreeLazyLoadDetails",
        "description": "Evento de lazy loading — preencher filhos assíncronos"
      },
      {
        "name": "after-show",
        "description": "Nó terminou de expandir (animação concluída). QTree não fornece payload."
      },
      {
        "name": "after-hide",
        "description": "Nó terminou de colapsar (animação concluída). QTree não fornece payload."
      }
    ],
    "slots": []
  },
