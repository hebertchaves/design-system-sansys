  "api": {
    "props": [
      {
        "name": "modelValue",
        "type": "string | number",
        "controlHint": "text",
        "description": "Valor do input (v-model)"
      },
      {
        "name": "variant",
        "type": "InputVariant",
        "controlHint": "segmented",
        "default": "outlined",
        "description": "Variante visual do input",
        "validValues": [
          "filled",
          "outlined",
          "standout",
          "borderless"
        ]
      },
      {
        "name": "type",
        "type": "InputType",
        "controlHint": "select",
        "default": "text",
        "description": "Tipo HTML do input",
        "validValues": [
          "text",
          "password",
          "email",
          "number",
          "tel",
          "url",
          "search",
          "date",
          "time",
          "datetime-local"
        ]
      },
      {
        "name": "dense",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Versão compacta (menor altura)"
      },
      {
        "name": "brand",
        "type": "InputBrand | null",
        "controlHint": "picker-brand",
        "default": "null",
        "description": "Marca Sansys (Hub, Water, Waste)",
        "validValues": [
          "hub",
          "water",
          "waste"
        ]
      },
      {
        "name": "label",
        "type": "string",
        "controlHint": "text",
        "description": "Label do input (floating label)"
      },
      {
        "name": "stackLabel",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Label sempre visível no topo (não flutua)"
      },
      {
        "name": "placeholder",
        "type": "string",
        "controlHint": "text",
        "description": "Placeholder do input"
      },
      {
        "name": "hint",
        "type": "string",
        "controlHint": "text",
        "description": "Texto de ajuda exibido abaixo do input"
      },
      {
        "name": "errorMessage",
        "type": "string",
        "controlHint": "text",
        "description": "Mensagem de erro exibida abaixo do input"
      },
      {
        "name": "error",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Estado de erro (muda cor para negativo)"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Input desabilitado"
      },
      {
        "name": "readonly",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Input somente leitura"
      },
      {
        "name": "loading",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Mostra indicador de loading (spinner)"
      },
      {
        "name": "required",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Input obrigatório (adiciona aria-required)"
      },
      {
        "name": "clearable",
        "type": "boolean",
        "controlHint": "toggle",
        "default": false,
        "description": "Mostra botão de limpar (×) quando há valor"
      },
      {
        "name": "ariaLabel",
        "type": "string",
        "controlHint": "text",
        "description": "Label de acessibilidade customizado para screen readers"
      },
      {
        "name": "clearAriaLabel",
        "type": "string",
        "controlHint": "text",
        "default": "Clear input",
        "description": "Label de acessibilidade para o botão de limpar"
      },
      {
        "name": "tabindex",
        "type": "number | string | null",
        "controlHint": "text",
        "default": "null (usa 0 por padrão)",
        "description": "Tabindex customizado"
      }
    ],
    "emits": [
      {
        "name": "update:modelValue",
        "payload": "string",
        "description": "Emitido quando o valor do input muda (v-model)"
      },
      {
        "name": "focus",
