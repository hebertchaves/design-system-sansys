{
  "mcpServers": {
    "dss": {
      "command": "node",
      "args": ["./packages/mcp/build/index.js"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${}"
      }
    },
    "figma-desktop": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--viewport",
        "1280x720",
        "--executablePath",
        "/home/hebertchaves/.cache/chrome-devtools-mcp/chrome"
      ]
    }
  }
}
