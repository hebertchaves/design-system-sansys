{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,

    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    /* Alias resolution — espelha vite.config.js resolve.alias */
    "baseUrl": ".",
    "paths": {
      "@dss/*":        ["../../packages/core/components/base/*"],
      "@components/*": ["../../packages/core/components/*"]
    }
  },
  "include": ["src", "*.js", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
