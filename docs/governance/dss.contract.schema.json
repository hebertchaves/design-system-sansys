{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sansys.dev/schemas/dss-component-contract.schema.json",
  "title": "DSS Component Contract",
  "description": "Contrato DERIVADO por componente (agregado dos donos por eixo, emitido por gate, nunca autorado à mão). Superfície única de leitura para playground e portal. Carrega SÓ verdade verificável ou derivável — orientação de uso (purpose.*) e examples[] são NÃO-NORMATIVOS e ficam FORA (D4/§4.2 do DSS_BLUEPRINT_CADEIA_FONTE_UNICA.md). Cadeia de verdade: CSS→meta (Princípio #12), types.ts (API), seals (selo).",
  "version": "1.0.0-draft",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "$comment": "additionalProperties:false rejeita purpose/examples e campos não-verificáveis (D4). patternProperties '^x-' libera extensões experimentais (padrão OpenAPI) sem bump. POLÍTICA DE EVOLUÇÃO: mudança de campo estável = evento versionado (schemaId dss-component-contract@1 → @2); campo experimental = prefixo x- até estabilizar.",
  "required": [
    "schemaId", "name", "version",
    "identity", "audit", "api", "visual", "tokens",
    "a11y", "antiPatterns", "bindingRules", "dependencies", "sources"
  ],
  "properties": {
    "schemaId": {
      "const": "dss-component-contract@1",
      "description": "Marcador de versão do contrato (não confundir com $schema do JSON Schema)."
    },
    "name": {
      "type": "string",
      "pattern": "^Dss[A-Z][A-Za-z0-9]+$",
      "description": "Nome canônico do componente. Deriva de meta.component."
    },
    "version": {
      "type": "string",
      "description": "Versão do componente (deriva de meta.dssVersion / package)."
    },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "TIER MUST-derivado.",
      "required": ["displayName", "tagline", "category", "classification", "phase", "status", "goldenReference", "goldenContext"],
      "properties": {
        "displayName": {
          "type": "string",
          "description": "DERIVADO: `Dss` removido + split camelCase (override só p/ irregular). §4.1.1 (mesma lógica do controlHint). Parser trata siglas coladas (ex.: DssSPCReport) via override em meta."
        },
        "tagline": {
          "type": "string",
          "maxLength": 120,
          "description": "UMA frase editorial curta ('o que é o componente'). TIER editorial com presence-gate (existe, não valida texto). Exceção mínima ao 'só verificável' — é naming, não orientação de uso. NÃO extraível do Quasar (api.json não traz descrição de componente)."
        },
        "category": { "type": "string", "description": "meta.category." },
        "classification": {
          "type": "string",
          "description": "meta.classification (ex.: Action/Compact/Visual). OBRIGATÓRIO — alinha com PAGE_STRUCTURE §9. Componentes sem o campo hoje (ex.: DssInput) exigem backfill do metadado."
        },
        "phase": { "type": "integer", "minimum": 1, "description": "meta.phase." },
        "status": {
          "type": "string",
          "enum": ["draft", "in-review", "approved", "deprecated"],
          "description": "meta.status."
        },
        "goldenReference": { "type": "string", "description": "meta.goldenReference (governança de categoria)." },
        "goldenContext": { "type": "string", "description": "meta.goldenContext (baseline de auditoria)." },
        "isGoldenSampleFor": {
          "type": "array",
          "items": { "type": "string", "enum": ["documentation", "architecture"] },
          "description": "Opcional. Ex.: DssButton → ['documentation']."
        }
      }
    },

    "audit": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "TIER MUST-derivado.",
      "required": ["status", "date", "sealPath"],
      "properties": {
        "status": { "type": "string", "enum": ["draft", "in-review", "approved", "deprecated"] },
        "date": { "type": "string", "format": "date", "description": "meta.auditDate normalizado." },
        "mode": { "type": "string", "description": "meta.auditMode (ex.: 'Final')." },
        "ncs": { "type": "integer", "minimum": 0, "description": "Não-conformidades abertas." },
        "gaps": { "type": "integer", "minimum": 0 },
        "sealPath": {
          "type": "string",
          "pattern": "^docs/compliance/",
          "description": "Caminho do selo NORMALIZADO. Item F: a fonte hoje traz 'DSS/docs/Compliance/…' (prefixo + casing) — o emitter normaliza para 'docs/compliance/…' (FS case-sensitive/CI)."
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "outcome"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "auditor": { "type": "string" },
              "outcome": { "type": "string" }
            }
          }
        }
      }
    },

    "api": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "TIER MUST-derivado — 100% de types/*.types.ts (validate-api-docs já cobre slots).",
      "required": ["props", "emits", "slots"],
      "properties": {
        "props": { "type": "array", "items": { "$ref": "#/definitions/prop" } },
        "emits": { "type": "array", "items": { "$ref": "#/definitions/emit" } },
        "slots": { "type": "array", "items": { "$ref": "#/definitions/slot" } },
        "exposedRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "description": "Deriva de types (ex.: InputExpose: focus/blur/inputRef)."
        },
        "vModel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prop", "event"],
          "properties": {
            "prop": { "type": "string" },
            "event": { "type": "string" }
          },
          "description": "Deriva por convenção: prop modelValue + emit update:modelValue."
        }
      }
    },

    "visual": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "TIER MUST-derivado — CSS→meta (Princípio #12). states: ACHADO DssInput — visualProperties só espelha hover/foco; falta active/disabled/loading (gap CSS→meta a fechar).",
      "required": ["defaultPreview", "dimensions", "states"],
      "properties": {
        "defaultPreview": {
          "type": "object",
          "required": ["props"],
          "properties": {
            "props": { "type": "object" },
            "slots": { "type": ["object", "null"] }
          },
          "description": "meta.defaultPreview."
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/tokenValue" },
          "description": "Ex.: minHeight, minWidth. Deriva de meta.defaultPreview.computedDimensions + visualProperties."
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "Estados presentes conforme o componente. Gate CSS→meta deve garantir mirror completo.",
          "properties": {
            "default": { "$ref": "#/definitions/stateVisual" },
            "hover": { "$ref": "#/definitions/stateVisual" },
            "focus": { "$ref": "#/definitions/stateVisual" },
            "active": { "$ref": "#/definitions/stateVisual" },
            "disabled": { "$ref": "#/definitions/stateVisual" },
            "loading": { "$ref": "#/definitions/stateVisual" }
          }
        },
        "variants": {
          "type": "object",
          "$comment": "TIER MAY — só quando a fonte declara. Ex.: size {xs,sm,md,lg}, density. DssInput NÃO tem size → sem seletor de tamanho no playground (regra exaustividade-fiel).",
          "additionalProperties": { "type": "object" }
        },
        "brands": {
          "type": "object",
          "$comment": "TIER MAY — só quando há override de brand.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tokensOverridden": { "type": "array", "items": { "type": "string", "pattern": "^--dss-" } }
            }
          }
        }
      }
    },

    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "TIER MUST-derivado. ACHADO DssInput: meta NÃO tem bloco tokens — instances derivam de visualProperties[].token (dedupe); categories por convenção de prefixo (--dss-spacing-* → spacing).",
      "required": ["categories", "instances"],
      "properties": {
        "categories": {
          "type": "array",
          "items": { "type": "string" },
          "description": "DERIVADO por prefixo do token. Ex.: spacing, color.action, typography. OBRIGATÓRIO — alinha com PAGE_STRUCTURE §7.3 (tipos, não instâncias)."
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^--dss-" },
              "usedIn": { "type": "array", "items": { "type": "string" } },
              "ref": { "type": "string", "description": "Âncora em DSS_TOKEN_REFERENCE.md." }
            }
          }
        }
      }
    },

    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "TIER MUST-VERIFICADO (§4.2). O gate NÃO checa presença de texto — checa correspondência com a implementação. `verifiedBy` é OBRIGATÓRIO em cada critério; claim sem âncora FALHA (mata 'escrever para passar').",
      "required": ["wcag", "aria", "keyboard"],
      "properties": {
        "wcag": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "level", "implementation", "verifiedBy"],
            "properties": {
              "criterion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
              "level": { "type": "string", "enum": ["A", "AA", "AAA"] },
              "implementation": { "type": "string" },
              "verifiedBy": {
                "type": "string",
                "enum": ["aria", "css", "test"],
                "description": "Âncora obrigatória: aria=atributo no SFC/DOM; css=token/regra no SCSS ou computed medível; test=caso no *.test.js."
              }
            }
          }
        },
        "aria": {
          "type": "object",
          "$comment": "Âncora: SFC/DOM renderizado.",
          "properties": {
            "role": { "type": "string" },
            "states": { "type": "array", "items": { "type": "string" } }
          }
        },
        "keyboard": {
          "type": "array",
          "$comment": "Âncora: *.test.js.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "action"],
            "properties": {
              "key": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        }
      }
    },

    "antiPatterns": {
      "type": "array",
      "$comment": "TIER MUST-VERIFICADO. Sem prosa livre: cada item DERIVA de um bindingRule (princípio com gate) e/ou aponta um alternativo EXISTENCE-CHECKED. `why` é a única frase humana admitida, e é opcional.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          { "required": ["rule"] },
          { "required": ["instead"] }
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^P[0-9]{2}$",
            "description": "Id do princípio vinculante (CLAUDE.md), ex.: P01, P08, P14. Verificável pelo gate do próprio princípio."
          },
          "instead": {
            "type": "string",
            "pattern": "^Dss[A-Z][A-Za-z0-9]+$",
            "description": "Componente-alternativo. EXISTENCE-CHECKED (tem que existir no sistema)."
          },
          "why": { "type": "string", "description": "Racional humano opcional (a única frase editorial, não gated como verdade)." }
        }
      }
    },

    "bindingRules": {
      "type": "array",
      "additionalProperties": false,
      "$comment": "TIER MUST-derivado — quais princípios aplicáveis e onde. Alimenta antiPatterns e a governança da página.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "appliesTo"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "name": { "type": "string" },
          "appliesTo": { "type": "array", "items": { "type": "string", "pattern": "^(api|visual|tokens|a11y)(\\.[a-zA-Z0-9*]+)*$" }, "description": "Caminhos canônicos (raiz ∈ {api,visual,tokens,a11y} + JSONPath simplificado). Ex.: visual.states, api.props.icon. Pattern evita emissores gerarem caminhos divergentes." }
        }
      }
    },

    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "TIER MUST-derivado (dss/quasar deriváveis; external MAY).",
      "required": ["dss", "quasar"],
      "properties": {
        "dss": { "type": "array", "items": { "type": "string", "pattern": "^Dss[A-Z]" } },
        "quasar": { "type": "array", "items": { "type": "string", "pattern": "^Q[A-Z]" } },
        "external": { "type": "array", "items": { "type": "string" } }
      }
    },

    "sources": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "TIER MUST-derivado — paths para o consumidor resolver (iframe monta sources.structure; anatomia deriva de sources.scss).",
      "required": ["structure", "scss", "types", "docs"],
      "properties": {
        "structure": { "type": "string" },
        "scss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["L2"],
          "properties": {
            "L2": { "type": "string" },
            "L3": { "type": "string" },
            "L4": { "type": "array", "items": { "type": "string" } }
          }
        },
        "types": { "type": "string" },
        "docs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "normative": { "type": "string" },
            "api": { "type": "string" },
            "readme": { "type": "string" }
          }
        },
        "examples": { "type": "string", "description": "Path do *.example.vue — NON-NORMATIVO (D4): referência para o sandbox, não fonte de verdade." },
        "tests": { "type": "string" },
        "seal": { "type": "string" }
      }
    }
  },

  "definitions": {
    "tokenValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": { "type": ["string", "null"], "description": "Nome do token --dss-* ou null quando não tokenizado." },
        "value": { "type": ["string", "null"] }
      }
    },
    "visualProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "source"],
      "properties": {
        "property": { "type": "string" },
        "token": { "type": ["string", "null"] },
        "value": { "type": ["string", "null"] },
        "source": { "type": "string", "description": "Arquivo SCSS de origem (Princípio #12), ex.: 2-composition/_base.scss." }
      }
    },
    "stateVisual": {
      "type": "array",
      "items": { "$ref": "#/definitions/visualProperty" },
      "description": "Propriedades visuais daquele estado, cada uma ancorada no SCSS de origem."
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "controlHint"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "description": "Assinatura TS (ex.: 'filled'|'outlined'|... )." },
        "default": { "description": "Valor default (deriva de withDefaults/@default JSDoc)." },
        "required": { "type": "boolean" },
        "description": { "type": "string", "description": "JSDoc da prop." },
        "controlHint": {
          "type": "string",
          "enum": ["toggle", "segmented", "select", "picker-color", "picker-feedback", "picker-brand", "stepper", "text", "textarea"],
          "description": "DERIVADO (§4.1.1) do type/validValues — campo de SAÍDA, nunca autorado. Governa o widget do knob no playground."
        },
        "validValues": {
          "type": "array",
          "description": "Valores do enum/union (alimenta seletores). Deriva do type."
        },
        "affects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Caminhos visuais afetados (ex.: visual.states.hover.background) — opcional, ajuda o playground."
        }
      }
    },
    "emit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "payload": { "type": "string", "description": "Tipo do payload (ex.: FocusEvent)." },
        "description": { "type": "string" }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "scope": { "type": ["string", "null"], "description": "Props expostas pelo slot (scoped) ou null." },
        "description": { "type": "string" }
      }
    }
  }
}
